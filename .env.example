# Copy to .env and fill in. .env is gitignored and must never be committed.

# Azure SQL
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=your-database
SQL_USER=your-user
SQL_PASSWORD=

# Azure OpenAI — batch pipeline only, never used at request time
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=chat
AZURE_OPENAI_EMBED_DEPLOYMENT=embeddings

# Azure AI Search — reference-document retrieval, batch only
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=

# Azure Document Intelligence — PDF layout extraction, batch only
AZURE_DOCINTEL_ENDPOINT=https://your-docintel.cognitiveservices.azure.com/
AZURE_DOCINTEL_KEY=

# Azure Language — batch only
AZURE_LANGUAGE_ENDPOINT=https://your-language.cognitiveservices.azure.com/
AZURE_LANGUAGE_KEY=
